# Copy this file to .env and fill in real values. Never commit .env.

# --- Google Gemini (chat + embeddings) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Pinecone (vector store) ---
PINECONE_API_KEY=
# Name of the Pinecone index to use/create for this project's vectors.
# Use a dedicated index -- do not point this at an index used by another
# project, since embedding dimensions / content would collide.
INDEX_NAME=travel-recommendation-agents
# Cloud/region for a new serverless index (only used the first time the
# index is created; ignored if INDEX_NAME already exists).
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- LangSmith (tracing/observability) ---
# Get a key at https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# Use a project name dedicated to this app so traces are easy to find.
LANGSMITH_PROJECT=travel-recommendation-agents

# --- Optional overrides ---
# EMBEDDING_MODEL=models/gemini-embedding-001
# EMBEDDING_DIMENSION=768
# CHAT_MODEL=gemini-2.5-flash
